  <Group Byte="0">Shutter</Group>
  <Capability Min="0" Max="7" Preset="ShutterOpen">No flash</Capability>
  <Capability Min="8" Max="255" Preset="StrobeSlowToFast">Stroboscopic slow to fast</Capability>
 </Channel>
 <Channel Name="Mode">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="10">DMX Mode (Ch 1-5 active)</Capability>
  <Capability Min="11" Max="60">Fixed Colors (7 colors)</Capability>
  <Capability Min="61" Max="110">Gradient Mode</Capability>
  <Capability Min="111" Max="160">Pulse Mode</Capability>
  <Capability Min="161" Max="210">Jump Mode</Capability>
  <Capability Min="211" Max="255">Audio Mode</Capability>
 </Channel>
 <Channel Name="Mode Speed" Preset="SpeedPanTiltSlowFast"/>
 <Mode Name="7 Channel">
  <Channel Number="1">Master Dimmer</Channel>
  <Channel Number="2">Red</Channel>
  <Channel Number="3">Green</Channel>
  <Channel Number="4">Blue</Channel>
  <Channel Number="5">Strobe</Channel>
  <Channel Number="6">Mode</Channel>
  <Channel Number="7">Mode Speed</Channel>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="0" ColourTemperature="0"/>
  <Dimensions Weight="1.0" Width="180" Height="180" Depth="100"/>
  <Lens Name="Other" DegreesMin="25" DegreesMax="25"/>
  <Focus Type="Fixed" PanMax="0" TiltMax="0"/>
